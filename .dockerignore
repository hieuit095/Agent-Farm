# ── Python ────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Git ───────────────────────────────────────────────
.git/
.gitignore

# ── Node ──────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log

# ── Build outputs ─────────────────────────────────────
dist/
build/
.next/

# ── Environment & secrets (mounted read-only at runtime)
.env
.env.*

# ── Data persistence (mounted as volumes at runtime) ──
data/
logs/

# ── ChromaDB vector store (persistent, large binary) ──
data/chroma_db/

# ── Tests (not needed in production image) ─────────────
tests/

# ── IDE / editor junk ─────────────────────────────────
.idea/
.vscode/
*.swp
*.swo