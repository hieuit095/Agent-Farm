# ╔══════════════════════════════════════════════════════════════════════╗
# ║                  Farm-Agent v3.0 — Environment Variables           ║
# ║                                                                    ║
# ║  Copy this file to .env and fill in your values.                   ║
# ║  NEVER commit your .env file to version control.                   ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── GitHub Authentication (Required) ──────────────────────────────────
# Personal access token with repo, read:org, and workflow scopes.
# Falls back to `gh auth token` CLI if left empty in config.yaml.
GITHUB_TOKEN=

# ── LLM Provider (Required) ───────────────────────────────────────────
# Minimax API key — required when provider is "minimax".
# Falls back to this env var if left empty in config.yaml.
MINIMAX_API_KEY=

# Minimax group ID — sent as X-Minimax-Group-Id header.
# Required by some Minimax plans; leave empty if unused.
MINIMAX_GROUP_ID=

# ── OpenRouter (Optional — Red Team Bloodhound audits) ──────────────────
# API key for OpenRouter, used by the Bloodhound Red Team pipeline
# to route White-Hat audit calls through cheaper/free models.
# Falls back to default LLM (Minimax) if not configured.
OPENROUTER_API_KEY=

# ── Notifications (Optional) ────────────────────────────────────────────
# Telegram bot token for push notifications (merge, close, run complete).
# Can also be set in config.yaml under notifications.telegram_token.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID — the destination chat for notification messages.
# Can also be set in config.yaml under notifications.telegram_chat_id.
TELEGRAM_CHAT_ID=

# Slack incoming webhook URL for push notifications.
# Can also be set in config.yaml under notifications.slack_webhook.
SLACK_WEBHOOK_URL=

# Discord incoming webhook URL for push notifications.
# Can also be set in config.yaml under notifications.discord_webhook.
DISCORD_WEBHOOK_URL=